# Python
__pycache__/
*.py[oc]
*.egg-info
build/
dist/
wheels/

# MkDocs output
/site/

# Virtual environments
.venv
.env
.direnv/
/mail.env
/secrets/
/deployment/provider-keys.fernet
/deployment/github.yaml
/deployment/*.pem

# Editor
.DS_Store
*.pem
*.swo
*.swp

# Node — the web/ app has its own tracked package.json/node_modules; these
# root-anchored entries only catch Node debris if npm is ever run from the repo
# root (which is a Python project). web/ uses its own .gitignore.
/node_modules/
/package.json
/package-lock.json

# Harness state lives in ~/.config/langmesh and is never tracked. The shippable default
# configuration is the empty template at src/langmesh/base/configuration.yaml;
# the runtime .langmesh/configuration.yaml holds real credentials, so it is ignored.
/.langmesh/

# Session checkpoints for the GitHub mention Action, restored by the workflow cache.
/.github/langmesh/

# Mention Action secret files (github.api_key, github.app.private_key). Same names
# as $XDG_DATA_HOME/langmesh/secrets. A self-hosted runner can keep them only there.
/.github/secrets/*
!/.github/secrets/README

# Command Code's per-workspace agent settings (permissions, taste) — personal tooling state.
/.commandcode/
