# Secret files for the mention Action. Same names as
# $XDG_DATA_HOME/langmesh/secrets/:
#
#   github.api_key              # provider key for .agents/agents/github/AGENT.md
#   github.app.private_key      # optional GitHub App PEM
#   providers.opencode.api_key  # optional; github.api_key is the fallback
#
#   printf '%s' 'sk-…' > github.api_key
#   chmod 600 github.api_key
#
# On a GitHub-hosted runner this directory is empty in git (public checkout).
# The job writes the files from the repository Actions secrets:
#
#   github_api_key           → github.api_key
#   github_app_private_key   → github.app.private_key
#
# Keep the same two files under $XDG_DATA_HOME/langmesh/secrets on a laptop.
# GitHub never returns secret values; the files on disk are the copy you can
# reuse. A self-hosted runner can keep the files only under XDG.
#
# Do not put secrets in .github/langmesh/ — that directory is the session artifact.
