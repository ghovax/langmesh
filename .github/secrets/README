# Secret files for the mention Action. Same names as
# $XDG_DATA_HOME/langmesh/secrets/:
#
#   github.api_key              # provider key for .agents/agents/github/AGENT.md
#   github.app.private_key      # optional GitHub App PEM
#   providers.anthropic.api_key # optional; github.api_key is the fallback
#
#   printf '%s' 'the-provider-key' > github.api_key
#   chmod 600 github.api_key
#
# The job copies these onto the XDG secrets directory. A self-hosted runner can
# keep the files only under XDG and omit this directory.
#
# GitHub-hosted runners only see files that are in the checkout. On a private
# repository you can commit them (`git add -f`). On a public repository that
# publishes the key; do not commit it.
#
# Do not put secrets in .github/langmesh/ — that directory is the session artifact.
