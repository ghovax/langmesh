# Secret files for mail. Copy this directory to the host as mode 0700, files 0600:
#   $XDG_DATA_HOME/langmesh/secrets/
#
# Each file is one value. Names match the configuration path:
#   email.imap.password
#   email.smtp.password          # only if SMTP is not the inferred provider host
#   email.oauth.client_secret    # optional, confidential OAuth apps
#   email.oauth.refresh_token    # `langmesh mail auth`
#   providers.<id>.api_key       # the catalogue provider mailbox sessions call
#
# The id is the catalogue provider (anthropic, openai, groq, custom, …) or that
# provider's credential_identifier. OpenCode Go bills as providers.opencode.api_key.
# ChatGPT and Cursor subscription providers do not use a key file.
#
# Gmail copies a 16-character app password with spaces; write it with or without
# spaces. LangMesh stores it without spaces.
#
#   printf '%s\n' 'the-app-password' > email.imap.password
#   printf '%s\n' 'the-provider-key' > providers.<id>.api_key
#   chmod 600 email.imap.password providers.<id>.api_key
#
# Do not commit filled files. install.sh copies ./secrets onto the host.
