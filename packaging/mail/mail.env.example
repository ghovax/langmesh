# Copy to mail.env (mode 0600). systemd EnvironmentFile and Fly secrets import this file.
#   sudo env LANGMESH_MAIL_ENV="$PWD/mail.env" packaging/mail/install.sh
# `langmesh mail` and `langmesh mail check` load this file from LANGMESH_MAIL_ENV,
# ./mail.env, /srv/langmesh/mail.env, or packaging/mail/mail.env. Already-set
# environment values win. Prove the mailbox before IDLE:
#   uv run langmesh mail check
# Values here win over configuration.yaml for the mail client.

LANGMESH_MAIL_ADDRESS=
LANGMESH_MAIL_ALLOW_FROM=
LANGMESH_MAIL_AGENT=reviewer
LANGMESH_MAIL_PASSWORD=
# LANGMESH_MAIL_IMAP_HOST=
# LANGMESH_MAIL_IMAP_USER=
# LANGMESH_MAIL_IMAP_PASSWORD=
# LANGMESH_MAIL_IMAP_PORT=993
# LANGMESH_MAIL_IMAP_SSL=true
# LANGMESH_MAIL_IMAP_MAILBOX=INBOX
# LANGMESH_MAIL_SMTP_HOST=
# LANGMESH_MAIL_SMTP_USER=
# LANGMESH_MAIL_SMTP_PASSWORD=
# LANGMESH_MAIL_SMTP_PORT=587
# LANGMESH_MAIL_SMTP_STARTTLS=true
# LANGMESH_MAIL_SMTP_USE_TLS=false
# LANGMESH_MAIL_WORKING_DIRECTORY=/srv/langmesh

# Provider key for the agent profile. reviewer defaults to OpenCode Go (OPENCODE_API_KEY).
# Mail waits for this the same way it waits for the mailbox password: without it, a turn 401s.
# OPENCODE_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
